WEBEX_API_BASE_URL=https://webexapis.com/v1

# Provider-owned OAuth Integration. Authorize this once as the provider.
INTEGRATION_CLIENT_ID=replace-me
INTEGRATION_CLIENT_SECRET=replace-me
INTEGRATION_REDIRECT_URI=https://provider.example/oauth/callback

# Customer-authorized Contact Center Service App.
SERVICE_APP_ID=replace-me
SERVICE_APP_CLIENT_ID=replace-me
SERVICE_APP_CLIENT_SECRET=replace-me

# Public callback and shared signing secret used by both lifecycle webhooks.
WEBHOOK_TARGET_URL=https://provider.example/webhooks/service-app
WEBHOOK_SECRET=replace-with-a-long-random-value

# Intended BYOVA Data Source configuration.
BYOVA_SCHEMA_ID=5397013b-7920-4ffc-807c-e8a3e0a18f43
BYOVA_DATA_SOURCE_URL=https://provider.example/byova
BYOVA_AUDIENCE=BYOVAGateway
BYOVA_SUBJECT=callAudioData
BYOVA_TOKEN_LIFE_MINUTES=60
